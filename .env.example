# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos
POSTGRES_DB=boliche_sig
POSTGRES_USER=boliche
POSTGRES_PASSWORD=boliche
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Operacion
PIN_MAX_INTENTOS=5
PIN_BLOQUEO_MINUTOS=15

# Un ajuste de inventario que supera este valor exige un autorizante.
AJUSTE_UMBRAL_AUTORIZACION=500

# Produccion (docker-compose.prod.yml)
DOMINIO=boliches.ejemplo.com
